+.actions-cell { display: flex; gap: 6px; flex-wrap: wrap; }
+.actions-cell select, .actions-cell button { width: auto; padding: 6px 8px; margin: 0; font-size: 13px; }
+.actions-cell button { background: var(--danger); }
+.actions-cell button:hover { background: #7f261f; }
+.actions-cell button.save { background: var(--success); }
+.actions-cell button.save:hover { background: #2f5540; }
+
+td input { width: 100%; padding: 6px; font-size: 13px; }
